# ==========================================
# Local AI Search Engine - Environment Variables
# ==========================================

# 1. Target Codebase Workspace Root
# Path to the local target repository to scan, index, and read.
# Used by rag-ops-ui (/api/agent) for the read_entire_file tool (with path traversal security guards),
# and by repo-indexer CLI agents (RepoIndexAgent, SearchAgent).
# If left blank, defaults to process.cwd() or the parent workspace directory.
WORKSPACE_ROOT=

# 2. Ollama Endpoint / Remote Tunnel URL
# Base URL for the Ollama inference server.
# - Local Mode: http://localhost:11434
# - Google Colab / Remote GPU Mode: Set to your tunnel URL (e.g., https://your-tunnel.ngrok-free.app)
#   or forward the remote port locally via SSH/ngrok to http://localhost:11434.
# Note: Core scripts currently default to http://localhost:11434 if unset.
OLLAMA_BASE_URL=http://localhost:11434

# 3. Google Gemini API Key (Optional)
# Used exclusively by repo-indexer/SummarizerSkill.ts to generate architectural file summaries
# via the @google/genai SDK (gemini-2.0-flash).
# If omitted, file summaries fallback to placeholder text and no remote API calls are made.
GEMINI_API_KEY=
