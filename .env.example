# ==========================================
# Local AI Search Engine - Environment Variables
# ==========================================

# Root directory of the target codebase to inspect, index, and read.
# Used by rag-ops-ui (/api/agent) to resolve relative file paths for the read_entire_file tool,
# and by repo-indexer CLI tools (RepoIndexAgent, SearchAgent) as the target repository path.
# If omitted or left blank, falls back to process.cwd() or the parent directory of repo-indexer.
WORKSPACE_ROOT=

# (Optional) Google Gemini API Key
# Used by repo-indexer/SummarizerSkill.ts to generate concise architectural summaries of indexed files.
# If omitted or left blank, the indexer skips AI summarization and uses a fallback placeholder.
GEMINI_API_KEY=

# Ollama Endpoint Configuration Note:
# In the current codebase, the Ollama service URL is hardcoded to http://localhost:11434 across
# repo-indexer and rag-ops-ui API routes.
# OLLAMA_BASE_URL=http://localhost:11434
